{
  "schedule": {
    "time": "02:30",
    "timezone": "America/Sao_Paulo"
  },
  "backup": {
    "provider": "postgres",
    "directory": "../db",
    "prefix": "paperclip",
    "compress": true
  },
  "source": {
    "host": "127.0.0.1",
    "port": 5433,
    "database": "paperclip",
    "username": "paperclip",
    "password_env": "PAPERCLIP_LOCAL_DB_PASSWORD"
  },
  "destinations": [
    {
      "host": "redundancy.example.com",
      "port": 5432,
      "database": "paperclip_redundancy",
      "username": "paperclip_redundancy",
      "password_env": "PAPERCLIP_REMOTE_DB_PASSWORD",
      "restore_strategy": "direct",
      "required_tables": [
        "companies",
        "agents",
        "issues",
        "heartbeat_runs"
      ]
    }
  ],
  "logging": {
    "file": "../logs/paperclip-postgres.log",
    "level": "INFO"
  },
  "maintenance": {
    "backup_retention_days": 14,
    "log_retention_days": 14,
    "log_max_bytes": 10485760,
    "log_keep_files": 5
  }
}
